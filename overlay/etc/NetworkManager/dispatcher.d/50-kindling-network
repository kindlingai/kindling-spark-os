#!/bin/sh
# On network changes:
# - when a link comes up, or NetworkManager reapplies a profile with another MTU, set the MTU again
#   from kindling-setup's --connectx-mtu and --ethernet-mtu. sparkos-mtu skips ports neither covers.
# - check that mentatd still answers (sparkos-mentatd-check), without waiting for the check.
case $2 in
	up|down|dhcp4-change|dhcp6-change|connectivity-change)
		systemctl start --no-block sparkos-mentatd-check.service ;;
esac
case $2 in
	up|reapply) exec /usr/local/sbin/sparkos-mtu "$1" ;;
esac
