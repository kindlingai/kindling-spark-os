# Tell GRUB this spark-os boot worked: clear the recordfail flag the menu entry set, as Ubuntu's
# grub-common does for DGX OS. If a boot never gets here, the flag stays set and GRUB's next boot
# picks DGX OS instead of this image (see /etc/grub.d/42_sparkos on the DGX OS root).
[Unit]
Description=Mark this spark-os boot as good for GRUB
After=multi-user.target
ConditionPathIsMountPoint=/run/sparkos/host
StartLimitIntervalSec=0

[Service]
Type=oneshot
# A bare chroot: grub-editenv needs nothing bound, so this cannot fail on anything enter-dgx-os sets
# up. If it does fail, the next boot goes to DGX OS, so it retries every 15 s until it succeeds.
ExecStart=/usr/sbin/chroot /run/sparkos/host /usr/bin/grub-editenv /boot/grub/grubenv unset recordfail
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
