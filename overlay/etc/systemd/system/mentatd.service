# The mentat node daemon, run from the image instead of a container. Per-node settings
# (MENTAT_SECRET_FILE, and optionally MENTAT_PEERS, MENTAT_ANNOUNCE_IFACES, MENTAT_NODE_IP) come
# from /etc/spark/node.env, which the initramfs copies from the box's own disk.
#
# Model containers register over 127.0.0.1:6379 and retry until the daemon answers, so
# start order against docker only delays them.
[Unit]
Description=mentat node daemon
After=network.target NetworkManager.service
ConditionPathExists=/etc/spark/node.env
# Without MENTAT_NODE_IP, mentatd takes its identity from the address it would use to reach the
# internet: the LAN address on every box. It reads that once, and with no route yet it would take
# 127.0.0.1, an identity every box shares, so the boxes never mesh. ExecStartPre fails until there
# is a route. It announces whichever MENTAT_ANNOUNCE_IFACES interfaces are up at the time. A box
# with no ConnectX cable (the card then leaves the PCI bus) still starts, announcing the LAN alone.
# It starts early rather than after network-online.target, which waits for the fabric ports too.
# Until the LAN is up it keeps retrying with no start limit, backing off from 2 s to 60 s.
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/spark/node.env
ExecStartPre=/bin/sh -c '[ -n "$${MENTAT_NODE_IP:-}" ] || ip -4 route get 8.8.8.8 >/dev/null'
ExecStart=/usr/local/bin/mentatd daemon
Restart=always
RestartSec=2
RestartSteps=10
RestartMaxDelaySec=60

[Install]
WantedBy=multi-user.target
