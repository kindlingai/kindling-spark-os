# The mentat node daemon, run from the image instead of a container. Per-node settings
# (MENTAT_NODE_IP, MENTAT_PEERS, MENTAT_ANNOUNCE_IFACES, MENTAT_SECRET_FILE) come from
# /etc/spark/node.env, which the initramfs copies from the box's own disk.
#
# Model containers register over 127.0.0.1:6379 and retry until the daemon answers, so
# start order against docker only delays them.
[Unit]
Description=mentat node daemon
After=network.target NetworkManager.service
ConditionPathExists=/etc/spark/node.env
# mentatd binds MENTAT_NODE_IP, the LAN address on every box, and announces whichever
# MENTAT_ANNOUNCE_IFACES interfaces are up at the time. A box with no ConnectX cable (the card then
# leaves the PCI bus) still starts, announcing the LAN alone. It starts early rather than after
# network-online.target, which waits for the fabric ports too. If the LAN address is not there yet,
# it keeps retrying with no start limit, backing off from 2 s to 60 s.
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/spark/node.env
ExecStart=/usr/local/bin/mentatd daemon
Restart=always
RestartSec=2
RestartSteps=10
RestartMaxDelaySec=60

[Install]
WantedBy=multi-user.target
