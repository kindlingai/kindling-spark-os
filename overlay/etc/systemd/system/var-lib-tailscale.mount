# Tailscale's state (node key, tailnet login) from the DGX OS root, so a box that runs Tailscale keeps
# its identity under spark-os without logging in again. Skipped on boxes without Tailscale.
[Unit]
Description=Tailscale state from the DGX OS install
ConditionPathIsDirectory=/run/sparkos/host/var/lib/tailscale
Before=tailscaled.service

[Mount]
What=/run/sparkos/host/var/lib/tailscale
Where=/var/lib/tailscale
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
