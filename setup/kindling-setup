#!/bin/bash
# Build a spark-os image for this box and install it beside DGX OS.
#
# Runs in the setup image, privileged, with the box's DGX OS root at /host. From DGX OS:
#
#   docker run --rm --privileged --network host -v /:/host kindling-spark-os install --trial
#
# From spark-os, mount the DGX OS root disk instead: -v /run/sparkos/host:/host
#
# Commands:
#   install [--flavour F] [--version V] [--site DIR] [--packages "P ..."] [--sources FILE]
#           [--mounts "DIR ..."] [--hostname-kindling] [--connectx-mtu N] [--ethernet-mtu N] [--trial]
#       Build an image and add it to GRUB. --trial also makes it the next boot, once. DGX OS stays
#       the default until sparkos-promote is run from a booted image.
#   build [--flavour F] [--version V] [--site DIR] [--packages "P ..."] [--sources FILE]
#         [--mounts "DIR ..."] [--out DIR]
#       Build only, into --out (default /host/var/tmp/kindling-spark-os/VERSION).
#   remove VERSION
#       Delete an installed image and its GRUB entry. Refuses the image that is running.
#   list
#       The images installed on the box, and GRUB's default and next entries.
#   stack
#       The kernel/driver pair this setup image carries.
#
# --flavour is nvidia (4 KiB pages) or nvidia-64k (64 KiB pages; its struct page array is 1/16
# the size, which returns about 2 GiB on a 128 GiB box, and it boots with THP off so the kernel's
# free-memory reserve stays at ~45 MB rather than 5% of RAM). Default: nvidia-64k.
#
# --version names the image; the default is the release, kernel ABI and flavour (0.9-1019-64k), the
# same on every box, with -2, -3 ... when that name is already installed here.
#
# --packages adds packages to the image, from Ubuntu, NVIDIA's repositories or a --sources file.
# --sources FILE (repeatable) adds an apt source: a .list or .sources file on the DGX OS root, such as
# /etc/apt/sources.list.d/tailscale.list. The keyrings it names are taken from the DGX OS root too.
# Tailscale: --sources /etc/apt/sources.list.d/tailscale.list --packages tailscale
# --mounts /var/lib/tailscale. The mount keeps the box's tailnet identity from DGX OS.
#
# --mounts "DIR ..." binds more directories from the DGX OS root, beside the built-in /home, /srv,
# /var/log, /var/lib/docker, /var/lib/containerd, /var/lib/spark-watchdog and /var/lib/nfs. Model
# recipes that keep weights or compose directories in /var/tmp want --mounts /var/tmp. System
# directories (/, /etc, /usr, /boot, /run, ...) are refused. install creates a missing source.
#
# --connectx-mtu N is the RoCE MTU for the ConnectX ports (256 ... 4096, default 4096; 0 turns it
# off). At boot each ConnectX port whose Ethernet MTU is too small for it is raised to N + 104 (4200
# for 4096); a larger MTU such as 9000 stays. --ethernet-mtu N sets the onboard Ethernet ports to
# exactly N; by default they keep DGX OS's setting. Raising an MTU needs the switch or peer to accept
# the larger frames.
#
# --hostname-kindling names the box kindling-XXXX under spark-os (XXXX: the last four hex digits of
# its LAN port's MAC, as NVIDIA's gx10-XXXX), recorded in /etc/kindling-spark-os/hostname on the DGX
# OS root. DGX OS keeps its own hostname. Delete that file to go back.
#
# --site DIR adds a site layer: DIR/root is copied over the image, DIR/packages.txt lists extra
# packages, and DIR/customize.d/*.sh run inside the image after the base customize step. Default:
# /host/etc/kindling-spark-os/site when it exists.
set -euo pipefail
K=/opt/kindling
host=${HOST_ROOT:-/host}
# shellcheck source=/dev/null
. "$K/stack/stack.env"

die() { echo "kindling-setup: $*" >&2; exit 1; }

# Runs a command in the DGX OS root. A private mount namespace keeps the /dev, /proc and /sys
# binds from outliving the call. They are needed when /host is a bare disk (from spark-os) and
# skipped when the host's own mounts are already there (from DGX OS, where -v binds recursively).
in_host() {
  unshare --mount --propagation private -- /bin/bash -euc '
    host=$1; shift
    for d in dev proc sys; do mountpoint -q "$host/$d" || mount --rbind "/$d" "$host/$d"; done
    exec chroot "$host" "$@"
  ' in_host "$host" "$@"
}

# update-grub in the DGX OS root. A failure is fatal: it would leave GRUB describing images that
# are not there, or missing ones that are.
update_grub() {
  local out
  out=$(in_host update-grub 2>&1) || { echo "$out" >&2; die "update-grub failed"; }
  echo "$out" | grep -E "spark-os|done" || true
}

check_host() {
  [ -f "$host/etc/os-release" ] || die "$host is not a root filesystem; mount the DGX OS root at /host"
  grep -q '^VERSION_ID="24.04"' "$host/etc/os-release" || die "$host is not Ubuntu 24.04"
  [ -d "$host/boot/grub" ] || die "$host/boot/grub is missing; is $host the DGX OS root?"
  for k in dgx_debian_prod.gpg cuda_debian_prod.gpg; do
    [ -f "$host/usr/share/keyrings/$k" ] || die "$host/usr/share/keyrings/$k is missing (needed for NVIDIA's repositories)"
  done
}

flavour=nvidia-64k version= site= out= trial=0 packages= sources=() mounts= hostname=
connectx_mtu=4096 ethernet_mtu=0
parse() {
  while [ $# -gt 0 ]; do
    case $1 in
      --flavour) flavour=$2; shift 2 ;;
      --version) version=$2; shift 2 ;;
      --site) site=$2; shift 2 ;;
      --out) out=$2; shift 2 ;;
      --trial) trial=1; shift ;;
      --packages) packages="$packages $2"; shift 2 ;;
      --sources) sources+=("$2"); shift 2 ;;
      --mounts) mounts="$mounts $2"; shift 2 ;;
      --hostname-kindling) hostname=kindling; shift ;;
      --connectx-mtu) connectx_mtu=$2; shift 2 ;;
      --ethernet-mtu) ethernet_mtu=$2; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  case " $FLAVOURS " in *" $flavour "*) ;; *) die "flavour $flavour is not one of: $FLAVOURS" ;; esac
  if [ -z "$version" ]; then
    local base n=2
    base=$(cat "$K/VERSION")-${KERNEL_ABI#*-}${flavour#nvidia}
    version=$base
    while [ -e "$host/boot/sparkos/$version" ]; do version=$base-$n; n=$((n + 1)); done
  fi
  [[ $version =~ ^[A-Za-z0-9._-]+$ ]] || die "version may hold only letters, digits, '.', '_' and '-'"
  case $connectx_mtu in 0|256|512|1024|2048|4096) ;; *) die "--connectx-mtu is a RoCE MTU: 256, 512, 1024, 2048, 4096, or 0 for off" ;; esac
  [[ $ethernet_mtu =~ ^[0-9]+$ ]] && { [ "$ethernet_mtu" = 0 ] || { [ "$ethernet_mtu" -ge 576 ] && [ "$ethernet_mtu" -le 9978 ]; }; } ||
    die "--ethernet-mtu is 576 to 9978, or 0 to keep DGX OS's setting"
  local m
  for m in $mounts; do
    [[ $m == /?* && $m != *..* && $m =~ ^[A-Za-z0-9._/-]+$ ]] || die "--mounts needs absolute paths: $m"
    case ${m%/} in
      /|/etc|/etc/*|/usr|/usr/*|/bin|/sbin|/lib|/lib64|/boot|/boot/*|/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*|/images|/images/*|/var|/var/lib)
        die "--mounts $m: a system directory cannot be bound from DGX OS" ;;
    esac
  done
  local src
  for src in "${sources[@]}"; do
    case $src in /*.list|/*.sources) ;; *) die "--sources needs an absolute .list or .sources path: $src" ;; esac
    [ -f "$host$src" ] || die "--sources $src: no such file on the DGX OS root"
  done
  if [ -z "$site" ] && [ -d "$host/etc/kindling-spark-os/site" ]; then site=$host/etc/kindling-spark-os/site; fi
  out=${out:-$host/var/tmp/kindling-spark-os/$version}
  # The build writes into $out and cleans it up afterwards, so it must not hold anything else.
  if [ -e "$out" ] && [ -n "$(ls -A "$out" 2>/dev/null)" ]; then
    die "$out exists and is not empty; --out needs a new or empty directory"
  fi
}

# Removes what a build put in $out, and $out itself only if that leaves it empty.
clean_out() {
  rm -rf "$out/work"
  rm -f "$out/spark-os.erofs" "$out/vmlinuz" "$out/initrd.img" "$out/cmdline"
  rmdir "$out" 2>/dev/null || true
}

build() {
  check_host
  echo "building spark-os $version: kernel $KERNEL_ABI-$flavour, driver $DRIVER${site:+, site layer $site}"
  # A failed build leaves a multi-GB rootfs behind, often on a disk that just ran out of space.
  [ -n "$packages" ] && echo "extra packages:$packages"
  [ ${#sources[@]} -gt 0 ] && echo "extra apt sources: ${sources[*]}"
  [ -n "$mounts" ] && echo "extra mounts:$mounts"
  echo "ConnectX RoCE MTU: ${connectx_mtu/#0/off}; Ethernet MTU: ${ethernet_mtu/#0/as DGX OS sets it}"
  OUT=$out VERSION=$version FLAVOUR=$flavour SITE=$site HOST=$host EXTRA_PACKAGES=$packages \
    EXTRA_SOURCES="${sources[*]}" EXTRA_MOUNTS=$mounts CONNECTX_MTU=$connectx_mtu ETHERNET_MTU=$ethernet_mtu \
    "$K/setup/build-rootfs.sh" ||
    { clean_out; die "build failed"; }
}

# A swap header records its page size, so a 64k image cannot use DGX OS's /swap.img. This makes a
# parallel /swap-64k.img on the same disk, once, the size of DGX OS's swap file (16 GiB on the
# Sparks), formatted for 64 KiB pages whatever kernel runs setup. sparkos-swap turns it on at boot.
# It is skipped, with a warning, if the disk would keep less than MIN_FREE_GIB (default 32) free.
parallel_swap() {
  local page f size=0 spec type free
  case $flavour in *-64k) page=65536 ;; *) return 0 ;; esac
  f=$host/swap-64k.img
  [ -f "$f" ] && return 0
  while read -r spec _ type _; do
    if [ "$type" = swap ] && [ "${spec#/}" != "$spec" ] && [ -f "$host$spec" ]; then
      size=$(stat -c %s "$host$spec"); break
    fi
  done < <(grep -v '^[[:space:]]*#' "$host/etc/fstab")
  [ "$size" -gt 0 ] || size=$((16 << 30))
  free=$(df -B1 --output=avail "$host" | tail -1)
  if [ $((free - size)) -lt $((${MIN_FREE_GIB:-32} << 30)) ]; then
    echo "warning: not making $f: the disk would keep less than ${MIN_FREE_GIB:-32} GiB free; the image will run without swap" >&2
    return 0
  fi
  fallocate -l "$size" "$f"
  chmod 600 "$f"
  mkswap -p "$page" "$f" >/dev/null
  change "made /swap-64k.img ($((size >> 30)) GiB swap for 64 KiB pages)" "swapoff /swap-64k.img 2>/dev/null; rm /swap-64k.img"
}

# Every change install makes to the DGX OS root is reported as a "change:" line and an "undo:" line,
# so a person or an agent reading setup.sh's log can reverse exactly that install. Undo commands are
# for DGX OS as root; from spark-os, run them through enter-dgx-os. A file install overwrites is
# first copied to /var/lib/kindling-spark-os/backup/<time>/.
change() { printf 'change: %s\n  undo: %s\n' "$1" "$2"; }
backup_dir=
# install_file MODE SRC DEST: install SRC at DEST (a path on the DGX OS root), reporting the change.
install_file() {
  local mode=$1 src=$2 dest=$3
  if [ ! -e "$host$dest" ]; then
    install -m "$mode" "$src" "$host$dest"
    change "added $dest" "rm $dest"
  elif ! cmp -s "$src" "$host$dest"; then
    backup_dir=${backup_dir:-/var/lib/kindling-spark-os/backup/$(date -u +%Y%m%dT%H%M%SZ)}
    install -d "$host$backup_dir"
    cp -p "$host$dest" "$host$backup_dir/"
    install -m "$mode" "$src" "$host$dest"
    change "replaced $dest (previous copy in $backup_dir)" "cp -p $backup_dir/${dest##*/} $dest"
  fi
}

# The box's LAN port MAC, as NVIDIA's gx10-XXXX names use: the default route's interface, else the
# first physical en* port. Reads /proc and /sys, since the setup image has no ip command.
lan_mac() {
  local iface
  iface=$(awk '$2 == "00000000" {print $1; exit}' /proc/net/route)
  if [ -z "$iface" ]; then
    for iface in /sys/class/net/en*; do [ -e "$iface/device" ] && break; done
    iface=${iface##*/}
  fi
  cat "/sys/class/net/$iface/address"
}

# Records kindling-XXXX as this box's hostname under spark-os. The initramfs uses it in place of
# DGX OS's.
kindling_hostname() {
  local mac name f=/etc/kindling-spark-os/hostname
  mac=$(lan_mac) || die "cannot find the LAN port's MAC for --hostname-kindling"
  mac=${mac//:/}
  name=kindling-${mac: -4}
  [ "$(cat "$host$f" 2>/dev/null)" = "$name" ] && return 0
  install -d "$host${f%/*}"
  echo "$name" > "$host$f"
  change "set the spark-os hostname to $name ($f)" "rm $f"
}

install_image() {
  local d=$host/boot/sparkos/$version dir saved
  [ -e "$d" ] && die "$d already exists; pick another --version"
  # The fallback to DGX OS after a failed boot matches spark-os entries by id, so a default saved as
  # a menu index (grub-set-default 2) would escape it. 0 is DGX OS itself.
  saved=$(in_host grub-editenv list | sed -n 's/^saved_entry=//p')
  index='^[0-9>]+$'
  if [[ $saved =~ $index && $saved != 0 ]]; then
    die "GRUB's saved default is the menu index $saved; set it by id or to DGX OS first: grub-set-default 0"
  fi
  echo "undo commands below are for DGX OS as root; from spark-os, prefix them with enter-dgx-os"
  install -d "$host/images" "$d"
  install -m644 "$out/spark-os.erofs" "$host/images/spark-os-$version.erofs"
  install -m644 "$out/vmlinuz" "$d/vmlinuz"
  install -m644 "$out/initrd.img" "$d/initrd.img"
  {
    echo "# One GRUB entry, read by /etc/grub.d/42_sparkos. Paths are on the root filesystem."
    echo "NAME=$version"
    echo "STACK=$STACK"
    echo "KINDLING=$(cat "$K/VERSION")"
    echo "KERNEL=/boot/sparkos/$version/vmlinuz"
    echo "INITRD=/boot/sparkos/$version/initrd.img"
    echo "IMAGE=/images/spark-os-$version.erofs"
    echo "CMDLINE=\"$(cat "$out/cmdline")\""
    echo "# 1 until sparkos-promote: the boot reverts to DGX OS unless confirmed within 10 minutes."
    echo "TRIAL=1"
  } > "$d/entry.conf"
  change "added image /images/spark-os-$version.erofs and /boot/sparkos/$version/ (kernel, initrd, entry.conf)" \
    "rm -rf /boot/sparkos/$version /images/spark-os-$version.erofs && update-grub   (or: kindling-setup remove $version)"
  # Sources for the image's bind mounts (setup/customize.sh) that DGX OS may not have made.
  for dir in /var/lib/spark-watchdog /var/lib/nfs /srv $mounts; do
    [ -d "$host$dir" ] && continue
    install -d "$host$dir"
    change "created $dir" "rmdir $dir"
  done
  install_file 755 "$K/setup/42_sparkos" /etc/grub.d/42_sparkos
  # The same one-command rollback on DGX OS as on spark-os.
  install_file 755 "$K/overlay/usr/local/sbin/sparkos-rollback" /usr/local/sbin/sparkos-rollback
  # GRUB_DEFAULT=saved lets grub-reboot choose a single boot while DGX OS (entry 0) stays the default.
  if [ ! -f "$host/etc/default/grub.d/99-sparkos.cfg" ]; then
    install -d "$host/etc/default/grub.d"
    echo 'GRUB_DEFAULT=saved' > "$host/etc/default/grub.d/99-sparkos.cfg"
    change "added /etc/default/grub.d/99-sparkos.cfg (GRUB_DEFAULT=saved)" "rm /etc/default/grub.d/99-sparkos.cfg && update-grub"
  fi
  if ! in_host grub-editenv list | grep -q '^saved_entry='; then
    in_host grub-editenv - set saved_entry=0
    change "set GRUB saved_entry=0 (DGX OS)" "grub-editenv /boot/grub/grubenv unset saved_entry"
  fi
  [ "$hostname" = kindling ] && kindling_hostname
  update_grub
  change "regenerated /boot/grub/grub.cfg" "update-grub, after the undos above"
  clean_out
  parallel_swap
  echo "installed spark-os $version"
  if [ "$trial" = 1 ]; then
    # A recordfail left by an interrupted DGX OS boot must not meet the new entry.
    in_host grub-editenv /boot/grub/grubenv unset recordfail
    in_host grub-reboot "sparkos-$version"
    change "queued spark-os $version as the next boot, once (GRUB next_entry)" "grub-editenv /boot/grub/grubenv unset next_entry"
    echo "the next boot, once, is spark-os $version; reboot when ready"
  fi
}

list() {
  local conf
  for conf in "$host"/boot/sparkos/*/entry.conf; do
    [ -f "$conf" ] || continue
    ( . "$conf"; printf '%-28s kindling %-5s stack %-24s trial=%s %s\n' "$NAME" "${KINDLING:-?}" \
        "${STACK:-?}" "$TRIAL" \
        "$(du -h "$host$IMAGE" 2>/dev/null | cut -f1)" )
  done
  in_host grub-editenv list
}

remove() {
  local version=${1:?usage: remove VERSION} d conf
  [[ $version =~ ^[A-Za-z0-9._-]+$ ]] && [[ $version != *..* ]] || die "not a version name: $version"
  d=$host/boot/sparkos/$version
  conf=$d/entry.conf
  [ -f "$conf" ] || die "no installed image $version"
  if grep -q "sparkos=$(. "$conf"; echo "$IMAGE")\( \|$\)" /proc/cmdline; then
    die "$version is the running image"
  fi
  rm -f "$host$(. "$conf"; echo "$IMAGE")"
  rm -rf "$d"
  update_grub
  echo "removed spark-os $version"
}

cmd=${1:---help}; shift || true
case $cmd in
  install) parse "$@"; build; install_image ;;
  build) parse "$@"; build; echo "built $out" ;;
  remove) remove "$@" ;;
  list) list ;;
  stack) echo "KINDLING=$(cat "$K/VERSION")"; cat "$K/stack/stack.env" ;;
  -h|--help|help) sed -n '2,/^set -euo/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//' ;;
  *) die "unknown command $cmd (try --help)" ;;
esac
