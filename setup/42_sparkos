#!/bin/sh
# GRUB entries for the spark-os images installed beside DGX OS, newest first: one per
# /boot/sparkos/*/entry.conf. Installed by kindling-spark-os; update-grub runs it.
#
# A failed spark-os boot must land in DGX OS without anyone at the console:
#   - every entry boots with panic=, so a panic reboots instead of hanging
#   - every entry calls recordfail (from DGX OS's 00_header), and sparkos-boot-ok clears it once the
#     image reaches multi-user. If it is still set when GRUB starts and the default is a spark-os
#     entry, the default becomes entry 0, DGX OS. One-shot (grub-reboot) boots never save it, so
#     trial boots rely on their own revert timer.
#   - fallback=0 covers an entry GRUB cannot load at all
#
# No set -e: grub-mkconfig runs under set -e, so one failing entry here would stop DGX OS's own
# update-grub, which its kernel updates depend on. A broken entry.conf, or one whose files are
# missing, is skipped instead.
ids=
for conf in $(ls -1 /boot/sparkos/*/entry.conf 2>/dev/null | sort -r); do
  entry=$(
    . "$conf" || exit 1
    for f in "$KERNEL" "$INITRD" "$IMAGE"; do
      [ -f "$f" ] || { echo "spark-os: skipping $conf, $f is missing" >&2; exit 1; }
    done
    if [ "${TRIAL:-1}" = 1 ]; then extra="sparkos.trial panic=10"; else extra="panic=30"; fi
    echo "spark-os $NAME" >&2
    cat <<EOF
menuentry "spark-os $NAME" --id sparkos-$NAME {
	recordfail
	search --no-floppy --fs-uuid --set=root $GRUB_DEVICE_UUID
	linux $KERNEL root=UUID=$GRUB_DEVICE_UUID rw sparkos=$IMAGE $extra $CMDLINE
	initrd $INITRD
}
EOF
  ) || continue
  echo "$entry"
  ids="$ids $(echo "$entry" | sed -n 's/.* --id \(sparkos-[^ ]*\) {$/\1/p')"
done

[ -n "$ids" ] || exit 0
echo 'set fallback="0"'
for id in $ids; do
  cat <<EOF
if [ "\${recordfail}" = 1 -a "\${default}" = "$id" ]; then set default="0"; fi
EOF
done
