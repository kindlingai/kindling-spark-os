+def _dispram():
+    """The dispram client, when it is importable and its daemon is running, else None.
+
+    dispram lends the GB10 display carveout, 2 GiB that the driver reserves and never uses on that
+    chip, to CUDA processes: https://github.com/kindlingai/kindling-spark-os/tree/main/dispram
+    """
+    try:
+        import dispram
+    except ImportError:
+        return None
+    return dispram if dispram.available() else None
+
+
+def dispram_reserve_bytes() -> int:
+    """Carveout bytes dispram can add to this worker's KV memory; 0 without dispram."""
+    dispram = _dispram()
+    return dispram.reserve_bytes() if dispram is not None else 0
+
+
+def _kv_backing_buffer(nbytes: int, device: torch.device) -> torch.Tensor:
+    """A zeroed int8 buffer for the KV cache. With dispram, its tail is the display carveout."""
+    dispram = _dispram()
+    if dispram is None:
+        return torch.zeros(nbytes, dtype=torch.int8, device=device)
+    buf, tail = dispram.glued_zeros(nbytes, device)
+    logger.info(
+        "KV cache buffer: %.2f GiB, of which %.2f GiB in the display carveout",
+        nbytes / 2**30,
+        tail / 2**30,
+    )
+    return buf
+
